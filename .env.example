# Required in production (server-only; never commit credentials)
ECHOPITCH_RUN_STORE=upstash
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
GITHUB_TOKEN=
LIVEPEER_MCP_URL=https://agent.livepeer.org/api/mcp/creative

# Optional runtime tuning (defaults are built into the server)
LIVEPEER_IMAGE_CAPABILITY=
LIVEPEER_VIDEO_CAPABILITY=
LIVEPEER_TTS_CAPABILITY=
LIVEPEER_POLL_INTERVAL_MS=
LIVEPEER_TIMEOUT_MS=

# The Creative MCP endpoint currently supports keyless demo credits. No API key is required.

# Optional Livepeer gate prompts used only by the integration scripts
LIVEPEER_IMAGE_PROMPT=
LIVEPEER_VIDEO_PROMPT=
