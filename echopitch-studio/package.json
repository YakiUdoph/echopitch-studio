{
  "name": "echopitch-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:intelligence",
    "test:intelligence": "node --experimental-strip-types --test tests/intelligence.test.ts tests/generalization.test.ts tests/production.test.ts tests/storage.test.ts",
    "test:generalization": "node --experimental-strip-types --test tests/generalization.test.ts",
    "test:creative-mcp": "node --experimental-strip-types --test --test-name-pattern=\"Livepeer|Creative MCP\" tests/production.test.ts",
    "test:production": "node --experimental-strip-types --test tests/production.test.ts tests/storage.test.ts",
    "test:production:live": "node --experimental-strip-types scripts/gate-c-test.ts",
    "test:intelligence:live": "node --experimental-strip-types scripts/gate-b-test.ts",
    "test:livepeer": "node --experimental-strip-types scripts/livepeer-foundation-test.ts",
    "test:phase-e": "node --experimental-strip-types scripts/gate-e-test.ts",
    "test:phase-f:tts": "node --experimental-strip-types scripts/gate-f-tts-test.ts",
    "test:phase-f:foreign": "node --experimental-strip-types scripts/gate-f-foreign-test.ts"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.4",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.26.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
